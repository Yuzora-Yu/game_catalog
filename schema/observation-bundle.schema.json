{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/game-catalog/observation-bundle.schema.json",
  "title": "Stream Pulse observation bundle",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "generated_at",
    "window",
    "games",
    "aliases"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "source": {
      "const": "stream_pulse"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "window": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "games": {
      "type": "object"
    },
    "aliases": {
      "type": "object"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "observed_at",
          "games",
          "aliases"
        ],
        "properties": {
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "games": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "aliases": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "snapshot_counts"
        ]
      }
    }
  ],
  "additionalProperties": false
}
