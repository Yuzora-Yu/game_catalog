{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/game-catalog/game.schema.json",
  "title": "Game catalog entry",
  "type": "object",
  "required": ["schema_version", "id", "status", "titles", "aliases", "releases", "companies", "platforms", "external_ids", "sales_observations", "verification"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "status": {"enum": ["active", "inactive", "merged", "hidden"]},
    "titles": {
      "type": "object",
      "required": ["primary", "ja", "en"],
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "ja": {"type": ["string", "null"]},
        "en": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "normalized", "kind", "source"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "normalized": {"type": "string", "minLength": 1},
          "kind": {"enum": ["official", "abbreviation", "community", "stream_observed", "hashtag", "romanization", "typo", "seed"]},
          "source": {"type": "string", "minLength": 1},
          "variants": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "first_seen": {"type": ["string", "null"]},
          "last_seen": {"type": ["string", "null"]},
          "observation_count": {"type": "integer", "minimum": 0},
          "channel_count": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "region", "platform", "source_url"],
        "properties": {
          "date": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
          "region": {"type": ["string", "null"]},
          "platform": {"type": ["string", "null"]},
          "source_url": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role", "source_url"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"enum": ["developer", "publisher", "porting", "other"]},
          "source_url": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "platforms": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "external_ids": {
      "type": "object",
      "properties": {
        "wikidata": {"type": ["string", "null"], "pattern": "^Q\\d+$"},
        "igdb": {"type": ["integer", "null"]},
        "steam_app": {"type": ["integer", "null"]}
      },
      "additionalProperties": true
    },
    "sales_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "unit", "scope", "as_of", "metric", "source_url"],
        "properties": {
          "value": {"type": "number", "minimum": 0},
          "unit": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "as_of": {"type": "string", "minLength": 4},
          "metric": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": ["status", "checked_at", "sources"],
      "properties": {
        "status": {"enum": ["seed_unverified", "partially_verified", "verified", "needs_review"]},
        "checked_at": {"type": ["string", "null"]},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "ref"],
            "properties": {
              "type": {"type": "string", "minLength": 1},
              "ref": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
